    "kind": "RANGES",
    "quote": "cells moved beyond the fixed worksheet boundary are discarded",
    "consequence": "Rectangles extend beyond [1, max_row] × [1, max_col]; output contains invalid coordinates",
    "guard": "Clip all rectangle coordinates to [1, max_row] and [1, max_col] after each edit; discard empty results"
   },
   {
    "kind": "OUTPUT",
    "quote": "Sort the result lexicographically. Return [] for an empty union",
    "consequence": "Output in arbitrary order or undefined behavior on empty set",
    "guard": "Sort (r1,c1,r2,c2) tuples using default lexicographic ordering; handle empty result as []"
   }
  ],
