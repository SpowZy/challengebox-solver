    "quote": "Attributes are in 1..=10^9",
    "consequence": "Solution indexes cells with array sized by attribute, crashes out-of-memory or panics",
    "guard": "Use HashMap or BTreeMap keyed by (object, attribute) pair for sparse cell storage"
   },
